# ==============================================================================
# PITA MEDIA - CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi '.env' di direktori yang sama:
#   copy .env.example .env (Windows) atau cp .env.example .env (Linux/macOS)
# JANGAN PERNAH MENYIMPAN ATAU MENG-COMMIT FILE '.env' KE GIT REPOSITORY!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI ECOSYSTEM (AI PROVIDER)
# ------------------------------------------------------------------------------
# Dapatkan Gemini API Key Anda dari Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# ------------------------------------------------------------------------------
# 2. TELEGRAM COMMAND & CONTROL (C2) & ALERTS
# ------------------------------------------------------------------------------
# 1) Buat bot baru melalui @BotFather di Telegram (https://t.me/BotFather) untuk mendapatkan Bot Token.
# 2) Dapatkan ID Akun Telegram Anda melalui @userinfobot (https://t.me/userinfobot).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# ID admin yang diizinkan mengontrol bot (pisahkan koma jika lebih dari satu)
TELEGRAM_ADMIN_IDS=123456789
# ID chat/channel tujuan notifikasi broadcast (bisa sama dengan admin id)
TELEGRAM_ALERT_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 3. STORAGE & MEDIA PROCESSING
# ------------------------------------------------------------------------------
# Path lokasi penyimpanan media lokal
STORAGE_PATH=storage
# Lokasi binary ffmpeg (biarkan kosong jika menggunakan imageio-ffmpeg bawaan / PATH)
FFMPEG_BINARY_PATH=
# Watermark / Signature teks jika diaktifkan
SIGNATURE_TEXT=Pita Waktu
ENABLE_SIGNATURE_WATERMARK=true

# ------------------------------------------------------------------------------
# 4. DATABASE & QUEUE
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///storage/pita_media.db
SQLITE_WAL_MODE=true
MAX_WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 5. GOVERNORS & RATE LIMITS
# ------------------------------------------------------------------------------
# Batas Biaya (USD)
DAILY_COST_LIMIT_USD=10.0
MONTHLY_COST_LIMIT_USD=200.0
COST_ALERT_THRESHOLD_PERCENT=80.0

# Frequency Governor (Menit minimum jeda antar posting per pilar)
MIN_POSTING_INTERVAL_MINUTES=60
# Persentase alokasi eksplorasi/novelty (20-30%)
EXPLORATION_QUOTA_PERCENT=25.0

# ------------------------------------------------------------------------------
# 6. QUALITY CONTROL (QC) THRESHOLDS
# ------------------------------------------------------------------------------
QC_TOTAL_PASS_THRESHOLD=8.0
QC_CATEGORY_PASS_THRESHOLD=7.0
MAX_AUTO_REPAIR_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 7. STATUS DASHBOARD (INTERNAL PROTECTED)
# ------------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=change_this_to_a_random_secure_string_for_session_auth
